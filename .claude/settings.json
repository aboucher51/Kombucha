{
  "permissions": {
    "allow": [
      "Bash(tools/check.sh*)",
      "Bash(tools/test.sh*)",
      "Bash(tools/shoot.sh*)",
      "Bash(godot4 --headless --path . --import)",
      "Bash(timeout * godot4 --headless --path .*)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(tools/sync-tooling.sh*)",
      "Bash(tools/check.local.sh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qE '\\.(gd|cs|tscn|tres|godot)\"' && command -v godot-map >/dev/null && godot-map . >/dev/null 2>&1; true"
          }
        ]
      }
    ]
  }
}
