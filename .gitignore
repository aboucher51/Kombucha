# Godot editor data — never commit
.godot/

# Local session memory, appended by the global PostCompact hook — not history
claude-log.md

# Screenshot harness output (and the .import sidecars the editor generates
# for PNGs that land inside res://)
shots/*
!shots/.gitkeep
# .gdignore keeps the editor out: a long-lived headless editor (the GDScript
# language server) imports every PNG under res:// and holds it; one project's
# reached 7.7 GB on ~3,600 shots. tools/shoot.sh and export.sh recreate both.
!shots/.gdignore

# Export artifacts
*.apk
*.aab
*.ipa
*.exe
*.x86_64
*.x86_32
*.arm32
*.arm64
*.pck
*.zip
export/
builds/*
!builds/.gdignore

# C# / Mono build output (if a project adds C#)
.mono/
bin/
obj/
*.csproj.user
*.sln.user
*.user

# IDE and OS files
.vs/
.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
