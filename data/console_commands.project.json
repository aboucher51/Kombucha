[
	{
		"id": "note",
		"handler": "note",
		"usage": "note [--kind=<kind>] <text>   (a flag before a rest argument)",
		"args": [
			{
				"name": "kind",
				"kind": "enum",
				"values": ["plain", "todo"],
				"flag": true,
				"default": "plain"
			},
			{
				"name": "text",
				"kind": "rest"
			}
		]
	},
	{
		"id": "seed",
		"handler": "seed",
		"usage": "seed <n>   (the fixture's own row: it replaces the core one)",
		"description": "Set the random seed. This row replaces the core seed row.",
		"args": [
			{
				"name": "n",
				"kind": "int",
				"required": true
			}
		]
	},
	{
		"id": "notes",
		"handler": "notes",
		"usage": "notes"
	},
	{
		"id": "busy",
		"handler": "busy",
		"usage": "busy <frames>",
		"args": [
			{
				"name": "frames",
				"kind": "int",
				"min": 0,
				"max": 9999999,
				"required": true
			}
		]
	},
	{
		"id": "goto",
		"handler": "goto",
		"usage": "goto <scene_path>   (leave the boot scene; the harness must return to it)",
		"args": [
			{
				"name": "scene_path",
				"kind": "string",
				"complete": "scenes",
				"required": true
			}
		]
	},
	{
		"buttons": [
			{"id": "notes", "label": "Show notes", "run": "notes", "group": "Fixture", "tip": "Prints every note."},
			{"id": "note", "label": "Add note", "run": "note", "group": "Fixture", "fill": true, "tip": "Starts a note for you to finish."}
		]
	}
]
