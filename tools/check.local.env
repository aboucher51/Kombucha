# The FIXTURE's settings for tools/check.sh: exists so the seam is
# exercised here. A real project starts from tools/seeds/check.local.env.
# A sync never touches this file. A variable already set when check.sh
# starts wins over the line here.

# The boot fails the check when it uses this much memory or more, in KB.
# Set to the default on purpose, so the check reports where it came from.
CHECK_RSS_BUDGET_KB=400000
